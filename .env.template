# 敏感配置文件模板
# 复制此文件为 .env 并填入实际值
# 不要将 .env 文件提交到版本控制系统！

# 以太坊私钥 (用于签名交易)
# 格式: 0x... (64个十六进制字符)
ETH_PRIVATE_KEY=your_ethereum_private_key_here

# Lighter API 私钥
# 格式: 0x... (64个十六进制字符)
LIGHTER_API_PRIVATE_KEY=your_lighter_api_private_key_here

# Account Index
ACCOUNT_INDEX=703305

# Lighter API URL
MAINNET_URL=https://mainnet.zklighter.elliot.ai

# Chain ID
CHAIN_ID=42161

# Web3 Provider URL
WEB3_PROVIDER_URL=https://arb1.arbitrum.io/rpc
